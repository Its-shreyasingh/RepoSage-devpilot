# PostgreSQL Configuration (Docker Compose runs on port 5432)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/reposage?stringtype=unspecified
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Google Gemini API Key (Required for RAG embeddings and AI Code Review)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override Gemini Model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# GitHub OAuth 2.0 (Set to true to enforce GitHub OAuth login; default is false for seamless demo mode)
APP_AUTH_ENABLED=false
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Frontend URL for CORS and OAuth2 redirect
FRONTEND_URL=http://localhost:5173
